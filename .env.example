# ================================================================
# PDDR - Personalized Diet Recommendation System Environment Config
# ================================================================

# PostgreSQL Database Connection
# In Railway: Use ${{Postgres.DATABASE_URL}} to connect to the Railway Postgres service
# In Local Dev: Use postgresql://postgres:password@localhost:5432/diet_db
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Web Server Port (automatically injected by Railway/Render)
PORT=8080

# Session Cookie Name
SESSION_COOKIE=pddr_session

# Google Gemini API Key (Required for Daylight AI Diet Assistant)
GEMINI_API_KEY=your-gemini-api-key-here

# ================================================================
# SMTP Email Service Configuration (Required for Live Reset Emails)
# ================================================================
# For Gmail:
#   1. Go to your Google Account -> Security.
#   2. Enable 2-Step Verification if not already enabled.
#   3. Go to App Passwords (search "App passwords" in Google account).
#   4. Generate an App Password for "PDDR" (generates a 16-character code).
#   5. Paste your Gmail address into SMTP_USER and the 16-character code into SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="PDDR Team" <your-email@gmail.com>

# Public Application Base URL (Set to your Railway generated domain, e.g. https://pddr-production.up.railway.app)
APP_BASE_URL=https://pddr-production.up.railway.app
