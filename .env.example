# ================================================================
# PDDR - Personalized Diet Recommendation System Environment Config
# ================================================================

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/diet_db

# Web Server Port
PORT=8080

# Session Cookie Name
SESSION_COOKIE=pddr_session

# ================================================================
# SMTP Email Service Configuration (Required for Live Reset Emails)
# ================================================================
# For Gmail:
#   1. Go to your Google Account -> Security.
#   2. Enable 2-Step Verification if not already enabled.
#   3. Go to App Passwords (search "App passwords" in Google account).
#   4. Generate an App Password for "PDDR" (generates a 16-character code).
#   5. Paste your Gmail address into SMTP_USER and the 16-character code into SMTP_PASS.
# For Custom / Enterprise SMTP:
#   Provide your SMTP server host, port (587 for STARTTLS, 465 for SSL), and credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="PDDR Team" <your-email@gmail.com>

# Public Application Base URL (Used for generating clickable reset links in emails)
APP_BASE_URL=http://localhost:8080
